// Bulk-RNAseq parameter config files.

// Define work directory
workDir = '/data/tmp/nf'

// Define parameters
params {
    // set global params
    input_dir = '/data/fastq/'
    output_dir = '/data/RNAseq'
    library = 'Illumina'
    ref_ver = 'hg38'
    save_failed_trim = false
    // FASTP parameters
    // fastp_params = "--trim_poly_g \\
    //                 --adapter_sequence=AGATCGGAAGAGCACACGTCTGAACTCCAGTCA \\
    //                 --adapter_sequence_r2=AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT"
    // STAR parameters
    
}

// Define process
process {
    penv = 'smp'
    queue = 'all.q@ngsnode1'
    // Set output path
    withName: FASTP {
        publishDir = [
            path: { "${params.output_dir}" }, 
            mode: 'link', 
            overwrite: false
        ]
        container = "docker://star:latest"
        ext = [
            args: """
                    --trim_poly_g \\
                    --adapter_sequence=AGATCGGAAGAGCACACGTCTGAACTCCAGTCA \\
                    --adapter_sequence_r2=AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT
                """
        ]
    }
    withName: GenomeGenerate {
        publishDir = [
            path: { "${params.output_dir}" }, 
            mode: 'link', 
            overwrite: false
        ]
        container = "docker://star"
        ext = [
            args: ""
        ]
    }
    withName: ALIGN {
        ext = [
            args: """
                    --chimSegmentMin 12 \  # ** essential to invoke chimeric read detection & reporting **
                    --chimJunctionOverhangMin 8 \
                    --chimOutJunctionFormat 1 \   # **essential** includes required metadata in Chimeric.junction.out file.
                    --alignSJDBoverhangMin 10 \
                    --alignMatesGapMax 100000 \   # avoid readthru fusions within 100k
                    --alignIntronMax 100000 \
                    --alignSJstitchMismatchNmax 5 -1 5 5 \   # settings improved certain chimera detections
                    --outSAMattrRGline ID:GRPundef \
                    --chimMultimapScoreRange 3 \
                    --chimScoreJunctionNonGTAG -4 \
                    --chimMultimapNmax 20 \
                    --chimNonchimScoreDropMin 10 \
                    --peOverlapNbasesMin 12 \
                    --peOverlapMMp 0.1 \
                    --alignInsertionFlush Right \
                    --alignSplicedMateMapLminOverLmate 0 \
                    --alignSplicedMateMapLmin 30
                """
        ]
    }

    withLabel: 'standard' {
        cpus = 4                        // CPU 사용량
        memory = '8 GB'                 // 메모리 사용량
    }
    withLabel: 'high' {
        cpus = 16                        // CPU 사용량
        memory = '48 GB'                 // 메모리 사용량
    }
}